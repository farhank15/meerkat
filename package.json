{
  "name": "meerkat",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "ingest": "node scripts/ingest-latest.mjs",
    "ingest:backfill": "node scripts/ingest-backfill.mjs",
    "gap:plans": "node scripts/gap-to-plans.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/db-backup.mjs",
    "db:audit": "node --env-file-if-exists=.env.local scripts/db-audit.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:dry": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs --dry-run",
    "db:status": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs --status",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui-drift.mjs",
    "check:fixtures": "node scripts/check-fixture-imports.mjs",
    "verify": "npm run typecheck && npm run check:ui && npm run check:fixtures && npm test && npm run build",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "score": "vite-node src/lib/cli/score.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^4.5.0",
    "nitro": "3.0.260610-beta",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.20.0",
    "fast-check": "^3.23.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
